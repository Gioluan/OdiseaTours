rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Tour documents: uploaded by Odisea staff from the CRM, downloadable by
    // link. "Signed in" no longer means staff: portal browsers sign in
    // anonymously, so writes are limited to staff accounts by uid.
    match /tours/{tourId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid in ['mN1vaWN1pjWzzdlBlxie8YyQAj02'];
    }
  }
}
